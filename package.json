{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that covers sensitive content on a page with opaque fills.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/engine/tsconfig.json && tsc -p tsconfig.node.json",
    "check:bundle": "node scripts/check-bundle.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:bundle && npm run check:contrast && playwright test"
  }
}
